# Deployment settings read by the scripts in scripts/. Copy to .env and fill in.
# The public origin comes from PUBLIC_ORIGIN in workers/mcp/wrangler.jsonc; MCP_ORIGIN overrides it.

# Auth0 custom or tenant domain used for sign-in, e.g. your-tenant.us.auth0.com
AUTH0_DOMAIN=
# Verified email whose Auth0 identities may use this deployment
TONES_OWNER_EMAIL=
# Ingest Worker origin used by the live check, e.g. https://style-ingest.<subdomain>.workers.dev
INGEST_ORIGIN=
