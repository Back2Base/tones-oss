{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "@cloudflare/workers-types",
      "node",
      "@cloudflare/vitest-plugin/types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.ts",
    "workers/**/*.ts",
    "tests/**/*.ts",
    "vitest*.config.ts",
    "scripts/**/*.ts"
  ]
}
